# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/opendoor_data
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# PostgreSQL Direct Connection (if not using DATABASE_URL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=opendoor
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=opendoor_data

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-secret-key-here-change-in-production
API_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CMS Data API
CMS_API_KEY=your_cms_api_key

# AWS Configuration (for S3 storage of large files)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=opendoor-data-platform

# GCP Configuration (alternative cloud storage)
GCP_PROJECT_ID=your_gcp_project
GCP_CREDENTIALS_PATH=/path/to/credentials.json
GCP_STORAGE_BUCKET=opendoor-data-platform

# Data Source URLs
NPPES_DOWNLOAD_URL=https://download.cms.gov/nppes/NPPES_Data_Dissemination_
CMS_PHYSICIAN_COMPARE_URL=https://data.cms.gov/provider-data/

# Pipeline Configuration
PIPELINE_BATCH_SIZE=10000
PIPELINE_MAX_WORKERS=4
PIPELINE_RETRY_ATTEMPTS=3
PIPELINE_RETRY_DELAY_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_PAYER_DATA_INGESTION=false
ENABLE_PRACTICE_FINANCIALS=false
